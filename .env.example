# Pick ONE provider. If both keys are set, OpenRouter wins unless LLM_PROVIDER says otherwise.
# LLM_PROVIDER=openrouter        # or: openai

# OpenRouter (free models, auto-discovered): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI: https://platform.openai.com/api-keys   (default model: gpt-5.4-mini for every role)
OPENAI_API_KEY=
# OPENAI_BASE_URL=               # Azure or any OpenAI-compatible server

# Optional model overrides per role (OpenRouter slug, or an OpenAI model id)
REVIEW_MODEL=
GRADER_MODEL=
ANALYST_MODEL=                   # tip: use your strongest model here

# Optional tuning
# OPENROUTER_RPS=0.3             # client-side limit for the OpenRouter free tier (~20 requests/min)
# OPENAI_RPS=                    # set to throttle OpenAI calls (off by default)
# OPENROUTER_FALLBACKS=1         # 0 disables request-level model fallbacks
# OPENROUTER_REQUIRE_PARAMS=1    # 0 lets OpenRouter route to providers that ignore tool calling
# LLM_SKIP_PROBE=1               # skip the pre-flight tool-calling test (saves ~3 requests)
